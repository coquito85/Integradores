<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- use o mesmo framework do ReferenciaFactory/GenerateJS (ex.: net8.0-windows) -->
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>EmissorLicencas</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<!-- usa CartorioLicense e LayoutCatalog do próprio aplicativo: assinatura e lista de modelos nunca divergem -->
		<ProjectReference Include="..\ReferenciaFactory\ReferenciaFactory.csproj" />
	</ItemGroup>
</Project>