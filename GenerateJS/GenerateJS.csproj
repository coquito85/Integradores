<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	  <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	  <Version>2.0.0</Version>
	  <Platforms>AnyCPU;x86</Platforms>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
	</ItemGroup>
	
  <ItemGroup>
    <!-- A tela so conversa com o ExecutorService; ele traz ReferenciaFactory e ReferenciaStandard -->
    <ProjectReference Include="..\ExecutorService\ExecutorService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tela (HTML/CSS/JS) fica ao lado do executavel. Os layouts XML ficam embutidos no ReferenciaStandard. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>