<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
	   <PackageId>BetaAnalytics.GeneratorJS</PackageId>
	  <RootNamespace>$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
	  <AssemblyName>BetaAnalytics.GeneratorJS</AssemblyName>
	  <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
	 
	 <!-- Remove pastas net10.0-windows e similares -->
	  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

	  <!-- Saída direta em bin\Debug / bin\Release -->
	  <OutputPath>bin\$(Configuration)\</OutputPath>
	  <!-- <OutputPath>bin\$(Configuration)\$(Platform)\</OutputPath>-->
	  <Platforms>AnyCPU;x86;x64</Platforms>
	  <AssemblyVersion>1.0.0.0</AssemblyVersion>
   <Version>1.0.0.0</Version>
  </PropertyGroup>
	
		<!-- x86 -->
	<PropertyGroup Condition="'$(Platform)'=='x86'">
		<PlatformTarget>x86</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>
	<!-- x64 -->
	<PropertyGroup Condition="'$(Platform)'=='x64'">
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>true</Prefer32Bit>
	</PropertyGroup>

	<!-- AnyCPU -->
	<PropertyGroup Condition="'$(Platform)'=='AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
	</PropertyGroup>

	

  <ItemGroup>
    <!-- Tela (HTML/CSS/JS) fica ao lado do executavel. Os layouts XML ficam embutidos no ReferenciaStandard. -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReferenciaFactory\ReferenciaFactory.csproj" />
  </ItemGroup>

<ItemGroup>
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
	</ItemGroup>
</Project>