<?xml version="1.0" encoding="utf-8"?>
<!--
  Comandos.xml  -  CENTRALIZADOR do menu e da barra padrao do editor de fluxos.

  Cada item aponta para um COMANDO (atributo "comando"). O codigo registra o que cada comando faz UMA vez
  (CentralComandos.Registrar) e o mesmo comando pode aparecer no menu, na barra, em varios lugares, com atalho.
  Menu e barra deixam de ter um handler por botao (como era no Studio original: mnuNovo_Click + tsBtnNovo_Click).

  Elementos:
    <Menu nome texto>               menu de topo (aceita <Item>, <Separador>, <Submenu> aninhados)
    <Item nome texto comando atalho dica visivel habilitado/>
    <Submenu nome texto especial>   especial="tema" -> o submenu e preenchido pelo TemaMenu ao abrir
    <Separador/>
    <Barra>                         barra padrao (aceita <Botao>, <Separador>, <Rotulo>)
    <Botao nome texto comando atalho dica cor habilitado visivel/>
    <Rotulo nome texto cor/>        texto fixo (ex.: contador de nos)

  Atributos:
    nome       nome do controle (permite sobrepor texto/visivel/habilitado no UiConfig.xml, como os demais controles)
    comando    id do comando (ex.: arquivo.novo). Sem handler registrado: o item aparece desabilitado.
    atalho     "Ctrl+N", "F5", "Ctrl+Shift+S"...
    cor        "@Perigo", "@Sucesso", "#RRGGBB"... (cor do texto; referencia o tema)
    habilitado estado INICIAL (a regra de estado em tempo real vem do codigo: Registrar(id, acao, habilitado))

  Sobreposicao: Config\Comandos.xml ao lado do .exe so precisa conter o que muda. Menus/botoes sao mesclados
  pelo atributo "nome"; para ocultar um item use visivel="false"; um item novo e acrescentado ao final.
  Ctrl+F5 na janela do editor recarrega este arquivo sem fechar o programa.
-->
<Comandos versao="1">

	<Menu nome="menuArquivo" texto="Arquivo">
		<Item nome="mnuNovo"       texto="Novo"                  comando="arquivo.novo"        atalho="Ctrl+N"/>
		<Item nome="mnuAbrir"      texto="Abrir..."              comando="arquivo.abrir"       atalho="Ctrl+O"/>
		<Item nome="mnuSalvar"     texto="Salvar"                comando="arquivo.salvar"      atalho="Ctrl+S"/>
		<Item nome="mnuSalvarComo" texto="Salvar como..."        comando="arquivo.salvarComo"/>
		<Item nome="mnuGerarCodigo" texto="Gerar código C#..."   comando="arquivo.gerarCodigo"/>
		<Separador/>
		<Item nome="mnuFechar"     texto="Voltar ao gerenciador" comando="arquivo.voltar"/>
	</Menu>

	<Menu nome="menuEditar" texto="Editar">
		<Item nome="mnuExcluirNo"     texto="Excluir nó selecionado" comando="editar.excluirNo"/>   <!-- Delete funciona no canvas (nao vira atalho global para nao apagar texto dos campos) -->
		<Item nome="mnuAjustarCanvas" texto="Ajustar canvas"         comando="exibir.ajustar"  atalho="Ctrl+F"/>
	</Menu>

	<Menu nome="menuFluxo" texto="Fluxo">
		<Item nome="mnuExecutar"  texto="Executar"       comando="fluxo.executar"  atalho="F5"/>
		<Item nome="mnuPausar"    texto="Pausar"         comando="fluxo.pausar"    atalho="F6"/>
		<Item nome="mnuParar"     texto="Parar"          comando="fluxo.parar"     atalho="F7"/>
		<Item nome="mnuGravar"    texto="Gravar ações..." comando="fluxo.gravar"/>
		<Item nome="mnuVariaveis" texto="Variáveis..."   comando="fluxo.variaveis"/>
	</Menu>

	<Menu nome="menuFerramentas" texto="Ferramentas">
		<Item nome="mnuSpyFinder"       texto="Tool Spy Finder"             comando="ferramentas.spy"       atalho="Ctrl+Shift+S"/>
		<Item nome="mnuGravadorAcoes"   texto="Gravador de Ações"           comando="ferramentas.gravador"  atalho="Ctrl+Shift+R"/>
		<Item nome="mnuCapturarMouse"   texto="Capturar posição do mouse"   comando="ferramentas.mouse"/>
		<Item nome="mnuLimparLog"       texto="Limpar log"                  comando="ferramentas.limparLog"/>
		<!-- No Studio original "Processos" e "PiP" disputavam o mesmo Ctrl+Shift+P; aqui o atalho fica so no PiP. -->
		<Item nome="mnuProcessos"       texto="Processos (agendamento)..."  comando="ferramentas.processos"/>
	</Menu>

	<Menu nome="menuExibir" texto="Exibir">
		<Item nome="mnuZoomIn"          texto="Zoom +"               comando="exibir.zoomIn"/>
		<Item nome="mnuZoomOut"         texto="Zoom −"               comando="exibir.zoomOut"/>
		<Item nome="mnuZoom100"         texto="Zoom 100%"            comando="exibir.zoom100"/>
		<Item nome="mnuAjustarTudo"     texto="Ajustar tudo"         comando="exibir.ajustar"/>
		<Item nome="mnuOrganizar"       texto="Organizar layout"     comando="exibir.organizar"/>
		<Separador/>
		<Item nome="mnuExibirAcoes"     texto="Mostrar Ações"        comando="exibir.painelAcoes"/>
		<Item nome="mnuExibirProps"     texto="Mostrar Propriedades" comando="exibir.painelProps"/>
		<Item nome="mnuExibirLog"       texto="Mostrar Log"          comando="exibir.painelLog"/>
		<Item nome="mnuExibirPip"       texto="Painel de Execução (PiP)" comando="exibir.pip" atalho="Ctrl+Shift+P"/>
		<Separador/>
		<Submenu nome="mnuTema" texto="Tema" especial="tema"/>
	</Menu>

	<Barra>
		<Botao nome="tsBtnNovo"      texto="🗋 Novo"       comando="arquivo.novo"      dica="Novo"/>
		<Botao nome="tsBtnAbrir"     texto="📂 Abrir"      comando="arquivo.abrir"     dica="Abrir"/>
		<Botao nome="tsBtnSalvar"    texto="💾 Salvar"     comando="arquivo.salvar"    dica="Salvar"/>
		<Botao nome="tsBtnFit"       texto="⊞ Ajustar"    comando="exibir.ajustar"    dica="Ajustar canvas"/>
		<Botao nome="tsBtnZoomIn"    texto="🔍+"           comando="exibir.zoomIn"     dica="Zoom in"/>
		<Botao nome="tsBtnZoomOut"   texto="🔍−"           comando="exibir.zoomOut"    dica="Zoom out"/>
		<Botao nome="tsBtnGravar"    texto="⏺ Gravar"     comando="fluxo.gravar"      dica="Gravar ações"          cor="@Perigo"/>
		<Botao nome="tsBtnRun"       texto="▶ Executar"   comando="fluxo.executar"    dica="Executar fluxo"        cor="@Sucesso"/>
		<Botao nome="tsBtnPause"     texto="⏸ Pausar"     comando="fluxo.pausar"      dica="Pausar execução"       cor="@Aviso"   habilitado="false"/>
		<Botao nome="tsBtnStop"      texto="⏹ Parar"      comando="fluxo.parar"       dica="Parar execução"        cor="@Perigo"  habilitado="false"/>
		<Botao nome="tsBtnOrganizar" texto="⬇ Organizar"  comando="exibir.organizar"  dica="Organizar nós verticalmente"/>
		<Botao nome="tsBtnPip"       texto="⚡ PiP"        comando="exibir.pip"        dica="Mostrar/ocultar painel de execução"/>
		<Rotulo nome="tsLblNodeCount" texto="0 nós  |  0 conexões" cor="@TextoSecundario"/>
	</Barra>

</Comandos>
