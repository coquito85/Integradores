<?xml version="1.0" encoding="utf-8"?>
<!--
  Acoes.xml  -  CATALOGO DE ACOES (a lista do painel "Catalogo de Acoes" e tudo o que cada icone faz).

  Uma <Acao> define o processo inteiro do icone, sem codigo novo:
    1) aparece no catalogo (categoria, rotulo, icone, cor da categoria);
    2) ao arrastar para o canvas (ou duplo clique) vira um no com os valores padrao das <Propriedade>;
    3) o painel Propriedades monta os campos a partir das <Propriedade> (tipo, lista, minimo, descricao...);
    4) ao executar, o atributo "executor" aponta para o executor registrado em RegistroExecutores
       (centralizador de execucao). O cartao mostra o texto de "resumo", com {Propriedade} trocado pelo valor.
  Acao SEM "executor" (ou com executor ainda nao registrado) aparece esmaecida no catalogo e nao pode ser
  arrastada; quando o executor for registrado no codigo ela se habilita sozinha, sem mexer neste arquivo.

  <Categoria nome cor>     grupo do catalogo. cor: "#RRGGBB" ou "@NomeDaCor" (cor de destaque dos icones)
  <Grupo texto/>           subtitulo dentro da categoria (ex.: "Condicao")
  <Acao nome rotulo icone executor resumo descricao>
      nome      id unico (ex.: mouse.clique) - e o que e gravado no arquivo do fluxo
      icone     glifo/emoji mostrado no catalogo e no cartao
  <Propriedade nome rotulo tipo padrao opcoes min max categoria descricao filtro obrigatorio>
      tipo: texto | textoLongo | int | numero | bool | lista | arquivo
      opcoes: valores da lista separados por "|"       filtro: "Planilhas (*.xlsx)|*.xlsx" (tipo arquivo)

  Toda acao recebe automaticamente "titulo" (Nome do card) e "emErro" (Stop | Continue | Retry); declare uma
  <Propriedade> com o mesmo nome para sobrescrever.
  Sobreposicao: Config\Acoes.xml ao lado do .exe (mescla por "nome"; acao nova e acrescentada na categoria).
-->
<Acoes versao="1">

	<Categoria nome="TECLADO / MOUSE" cor="#4FC3F7">
		<Acao nome="mouse.clique" rotulo="Clique" icone="◉" executor="mouse.clique"
			  resumo="({X}, {Y}) · {botao} ×{cliques}"
			  descricao="Clica numa posição da tela (ou na posição guardada numa variável).">
			<Propriedade nome="X" rotulo="X" tipo="int" padrao="0" min="0" categoria="Ação/Posição" descricao="Coordenada horizontal (pixels) na tela."/>
			<Propriedade nome="Y" rotulo="Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição" descricao="Coordenada vertical (pixels) na tela."/>
			<Propriedade nome="botao" rotulo="Botão" tipo="lista" opcoes="Left|Right|Middle" padrao="Left" categoria="Ação/Posição" descricao="Botão do mouse."/>
			<Propriedade nome="cliques" rotulo="Número de cliques" tipo="int" padrao="1" min="1" categoria="Ação/Posição" descricao="1 = clique simples, 2 = duplo clique."/>
			<Propriedade nome="velocidade" rotulo="Velocidade" tipo="int" padrao="5" min="0" max="100" categoria="Ação/Posição" descricao="0 = instantâneo; 1 (rápido) a 100 (lento)."/>
			<Propriedade nome="janelaAlvo" rotulo="Janela alvo" tipo="texto" padrao="" categoria="Geral" descricao="Título (parcial) da janela a ativar antes do clique. Vazio = não ativa."/>
			<Propriedade nome="posVar" rotulo="Posição de origem (variável)" tipo="texto" padrao="" categoria="Geral" descricao="Nome de uma variável com 'X,Y'. Se preenchida, substitui X e Y."/>
		</Acao>
		<Acao nome="mouse.mover" rotulo="Mover" icone="➤" executor="mouse.mover"
			  resumo="para ({X}, {Y}) · vel {velocidade}"
			  descricao="Move o ponteiro do mouse até uma posição da tela.">
			<Propriedade nome="X" rotulo="X" tipo="int" padrao="0" min="0" categoria="Ação/Posição" descricao="Coordenada horizontal (pixels) na tela."/>
			<Propriedade nome="Y" rotulo="Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição" descricao="Coordenada vertical (pixels) na tela."/>
			<Propriedade nome="velocidade" rotulo="Velocidade" tipo="int" padrao="10" min="1" max="100" categoria="Ação/Posição" descricao="1 (rápido) a 100 (lento)."/>
		</Acao>
		<Acao nome="mouse.arrastar" rotulo="Arrastar" icone="⇄" executor="mouse.arrastar"
			  resumo="({DeX},{DeY}) → ({ParaX},{ParaY})"
			  descricao="Arrasta com o botão esquerdo de um ponto a outro.">
			<Propriedade nome="DeX" rotulo="De X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="DeY" rotulo="De Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="ParaX" rotulo="Para X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="ParaY" rotulo="Para Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="velocidade" rotulo="Velocidade" tipo="int" padrao="5" min="1" max="100" categoria="Ação/Posição"/>
		</Acao>
		<Acao nome="mouse.scroll" rotulo="Scroll" icone="↕" executor="mouse.scroll"
			  resumo="{direcao} ×{cliques} em ({X},{Y})"
			  descricao="Gira a roda do mouse numa posição.">
			<Propriedade nome="X" rotulo="X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="Y" rotulo="Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="direcao" rotulo="Direção" tipo="lista" opcoes="Down|Up" padrao="Down" categoria="Ação/Posição"/>
			<Propriedade nome="cliques" rotulo="Cliques da roda" tipo="int" padrao="3" min="1" categoria="Ação/Posição"/>
		</Acao>
		<Acao nome="mouse.palavra" rotulo="Selecionar palavra" icone="▣" executor="mouse.palavra"
			  resumo="em ({X}, {Y})" descricao="Duplo clique para selecionar a palavra sob o ponteiro.">
			<Propriedade nome="X" rotulo="X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="Y" rotulo="Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
		</Acao>
		<Acao nome="mouse.texto" rotulo="Selecionar texto" icone="▤" executor="mouse.texto"
			  resumo="({DeX},{DeY}) → ({AteX},{AteY})" descricao="Seleciona texto arrastando de um ponto a outro.">
			<Propriedade nome="DeX" rotulo="De X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="DeY" rotulo="De Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="AteX" rotulo="Até X" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="AteY" rotulo="Até Y" tipo="int" padrao="0" min="0" categoria="Ação/Posição"/>
			<Propriedade nome="velocidade" rotulo="Velocidade" tipo="int" padrao="5" min="1" max="100" categoria="Ação/Posição"/>
		</Acao>
		<Acao nome="teclado.digitar" rotulo="Digitar texto" icone="T" executor="teclado.digitar"
			  resumo="{texto}" descricao="Digita um texto (aceita variáveis no formato {{nome}}).">
			<Propriedade nome="texto" rotulo="Texto" tipo="textoLongo" padrao="" categoria="Geral" descricao="Texto a digitar. Use {{variavel}} para inserir variáveis."/>
			<Propriedade nome="atraso" rotulo="Atraso entre teclas (ms)" tipo="int" padrao="20" min="0" categoria="Ação/Posição"/>
		</Acao>
		<Acao nome="teclado.tecla" rotulo="Tecla especial" icone="⌨" executor="teclado.tecla"
			  resumo="{ctrl}{shift}{alt}{tecla}" descricao="Envia uma tecla ou atalho (ex.: Ctrl+C, Enter, F5).">
			<Propriedade nome="tecla" rotulo="Tecla" tipo="texto" padrao="Enter" categoria="Geral" descricao="Nome da tecla: Enter, Tab, Esc, F5, a, c..."/>
			<Propriedade nome="ctrl" rotulo="Ctrl" tipo="bool" padrao="false" categoria="Ação/Posição"/>
			<Propriedade nome="shift" rotulo="Shift" tipo="bool" padrao="false" categoria="Ação/Posição"/>
			<Propriedade nome="alt" rotulo="Alt" tipo="bool" padrao="false" categoria="Ação/Posição"/>
		</Acao>
	</Categoria>

	<Categoria nome="FLUXO" cor="#FACC15">
		<Grupo texto="Controle"/>
		<Acao nome="fluxo.inicio" rotulo="Início" icone="▶" executor="fluxo.inicio" resumo="Gatilho: {gatilho}" descricao="Ponto de partida do fluxo.">
			<Propriedade nome="gatilho" rotulo="Tipo de gatilho" tipo="lista" opcoes="Manual|Agendado|Tecla de atalho" padrao="Manual" categoria="Geral"/>
		</Acao>
		<Acao nome="fluxo.fim" rotulo="Fim" icone="■" executor="fluxo.fim" resumo="Encerra o fluxo" descricao="Encerra a execução."/>
		<Acao nome="fluxo.aguardar" rotulo="Aguardar" icone="⏳" executor="fluxo.aguardar" resumo="{tempoMs} ms" descricao="Pausa a execução por um tempo.">
			<Propriedade nome="tempoMs" rotulo="Tempo (ms)" tipo="int" padrao="1000" min="0" categoria="Geral"/>
		</Acao>
		<Grupo texto="Condição"/>
		<Acao nome="fluxo.if" rotulo="If / Else" icone="?"/>
		<Acao nome="fluxo.elseif" rotulo="Else If" icone="?:"/>
		<Grupo texto="Laços"/>
		<Acao nome="fluxo.for" rotulo="For  (contador)" icone="↻"/>
		<Acao nome="fluxo.while" rotulo="While  (condição)" icone="⟳"/>
		<Acao nome="fluxo.foreach" rotulo="ForEach  (lista)" icone="∀"/>
		<Acao nome="fluxo.continue" rotulo="Próximo loop" icone="⏭"/>
		<Acao nome="fluxo.break" rotulo="Sair do loop" icone="✕"/>
		<Grupo texto="Script"/>
		<Acao nome="fluxo.autoit" rotulo="Executar AutoIt (.au3)" icone="⚙"/>
		<Grupo texto="Sub-rotina"/>
		<Acao nome="fluxo.chamar" rotulo="Chamar Fluxo" icone="📞"/>
		<Grupo texto="Anotação"/>
		<Acao nome="fluxo.comentario" rotulo="Comentário" icone="💬" executor="fluxo.comentario" resumo="{texto}" descricao="Anotação visual; não executa nada.">
			<Propriedade nome="texto" rotulo="Texto" tipo="textoLongo" padrao="" categoria="Geral"/>
		</Acao>
	</Categoria>

	<Categoria nome="JANELA / APP" cor="#B39DDB">
		<Acao nome="janela.abrir" rotulo="Abrir aplicativo" icone="⚡"/>
		<Acao nome="janela.focar" rotulo="Focar janela" icone="□"/>
		<Acao nome="janela.captura" rotulo="Capturar tela" icone="📷"/>
