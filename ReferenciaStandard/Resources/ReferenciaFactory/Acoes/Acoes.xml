	<Categoria nome="SIKULI" cor="#FFB74D">
		<Grupo texto="Localizar"/>
		<Acao nome="sikuli.find" rotulo="Localizar na tela" icone="🔍"/>
		<Acao nome="sikuli.wait" rotulo="Aguardar aparecer" icone="⏳"/>
		<Acao nome="sikuli.vanish" rotulo="Aguardar sumir" icone="⌛"/>
		<Acao nome="sikuli.exists" rotulo="Verificar existe" icone="✔"/>
		<Grupo texto="Interação"/>
		<Acao nome="sikuli.click" rotulo="Clicar imagem" icone="🖼"/>
		<Acao nome="sikuli.dblclick" rotulo="Duplo clique" icone="◎"/>
		<Acao nome="sikuli.rclick" rotulo="Clique direito" icone="◉"/>
		<Acao nome="sikuli.hover" rotulo="Hover (passar mouse)" icone="➤"/>
